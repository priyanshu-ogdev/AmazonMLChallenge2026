# =============================================================================
# Amazon ML Challenge 2026 - .gitignore
# =============================================================================

# Large Data Files (Ignore by default, except dataset/ and output/ tracked via Git LFS)
data/
*.tsv
*.csv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.jsonl

# Explicitly track dataset/ via Git LFS
!dataset/
!dataset/**
!dataset/**/*.tsv
!dataset/**/*.csv

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Model Checkpoints & Large Weights
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.pickle
checkpoints/
models/
saved_models/
weights/

# Experiment Tracking & Logs
wandb/
runs/
logs/
*.log
tensorboard/

# Outputs, Cache & Submission Archives (Tracked via Git LFS)
!output/
!output/**
!output/**/*.tsv
!output/**/*.csv
!output/**/*.pkl
!output/**/*.pickle
!output/**/*.pt
!output/**/*.pth
!output/**/*.bin
!output/**/*.safetensors
!output/**/*.onnx
!output/**/*.npz
output/**/_tmp_worker_chunks/
output/**/checkpoint_backup/
output/**/*.tmp
submissions/
*.zip
*.tar.gz
*.rar

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
