# =============================================================================
# Amazon ML Challenge 2026 - .gitignore
# =============================================================================

# Large Data & Datasets
data/
dataset/
output/
scratch/
*.tsv
*.csv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.jsonl

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Model Checkpoints, Large Weights & Cache
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.pickle
checkpoints/
models/
saved_models/
weights/

# Experiment Tracking & Logs
wandb/
runs/
logs/
*.log
tensorboard/

# Submissions & Archives
submissions/
*.zip
*.tar.gz
*.rar

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
